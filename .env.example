# GRACE API keys — copy to .env and fill in only the ones you have. .env is git-ignored.
#
#   copy .env.example .env
#
# Every key is optional. Without network or keys GRACE still runs gestures, hotkeys, the
# overlay and the fixed commands. A missing key just disables that service.
# Never commit .env, paste keys into settings.yaml, or pass them on the command line.

# Groq: LLM + Whisper STT (https://console.groq.com/keys)
GROQ_API_KEY=

# Google Gemini via AI Studio (https://aistudio.google.com/apikey): LLM fallback
GEMINI_API_KEY=

# OpenRouter, ":free" models only (https://openrouter.ai/keys): last-resort LLM
OPENROUTER_API_KEY=

# Cloudflare Workers AI: image generation with FLUX.1 schnell (free 10,000 neurons/day).
# Account ID: dash.cloudflare.com -> Workers AI. Token: My Profile -> API Tokens -> Create Token,
# permissions "Workers AI: Read" and "Workers AI: Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Tavily: web search (https://app.tavily.com, free 1,000 credits/month, no card)
TAVILY_API_KEY=
