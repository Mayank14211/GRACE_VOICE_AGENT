# GRACE API keys — copy to .env and fill in only the ones you have. .env is git-ignored.
#
#   copy .env.example .env
#
# Every key is optional. GRACE works offline without any of them (wake word, English STT,
# gestures, fixed commands). A missing key just disables that cloud provider.
# Never commit .env, paste keys into settings.yaml, or pass them on the command line.

# Groq: LLM + Whisper STT (https://console.groq.com/keys)
GROQ_API_KEY=

# Google Gemini via AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenRouter, ":free" models only (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
